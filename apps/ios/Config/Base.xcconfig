CALL_DIRECTORY_EXTENSION_BUNDLE_IDENTIFIER = com.example.EmployeeCallerID.CallDirectory
APP_GROUP_IDENTIFIER = group.com.example.EmployeeCallerID
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

#include? "Local.xcconfig"
